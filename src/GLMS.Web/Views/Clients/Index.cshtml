@model IEnumerable<GLMS.Web.Models.Client>
@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Clients</h1>
    <a class="btn btn-primary" asp-action="Create">Add client</a>
</div>

<table class="table table-striped">
    <thead><tr><th>Name</th><th>Contact details</th><th>Region</th></tr></thead>
    <tbody>
    @foreach (var client in Model)
    {
        <tr><td>@client.Name</td><td>@client.ContactDetails</td><td>@client.Region</td></tr>
    }
    </tbody>
</table>
